{
  extends: [
    "github>suzuki-shunsuke/renovate-config#4.0.0",
    "github>suzuki-shunsuke/renovate-config:nolimit#4.0.0",
    "github>aquaproj/aqua-renovate-config#2.13.0",
  ],
  // The packages are generated files, thousands of them, and none is a dependency
  // Renovate could update.
  ignorePaths: ["pkgs/**"],
}
